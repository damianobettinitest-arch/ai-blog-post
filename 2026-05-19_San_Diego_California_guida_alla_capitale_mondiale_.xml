    <item>
        <title>San Diego (California): Guida Alla Capitale Mondiale Delle Iconiche West Coast IPA</title>
        <link>https://www.lacasettacraftbeercrew.it/san-diego-california-guida-alla-capitale-mondiale-delle-iconiche-west-coast-ipa</link>
        <pubDate>Tue, 06 May 2025 08:00:00 +0200</pubDate>
        <dc:creator>admin</dc:creator>
        <guid isPermaLink="false">https://www.lacasettacraftbeercrew.it/san-diego-california-guida-alla-capitale-mondiale-delle-iconiche-west-coast-ipa</guid>
        <description></description>
        <content:encoded><![CDATA[
